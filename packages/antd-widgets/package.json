{
  "name": "@wirework/antd-widgets",
  "version": "0.1.0",
  "private": false,
  "license": "UNLICENSED",
  "type": "module",
  "files": ["dist", "src/styles.css"],
  "sideEffects": ["**/*.css"],
  "publishConfig": {
    "access": "restricted",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "./styles.css": "./src/styles.css"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./stories": "./src/stories/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "@wirework/react": "workspace:*",
    "@wirework/schema": "workspace:*",
    "@wirework/widget-contracts": "workspace:*",
    "antd": "catalog:",
    "react": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@wirework/engine": "workspace:*",
    "@wirework/events": "workspace:*",
    "@wirework/react": "workspace:*",
    "@wirework/schema": "workspace:*",
    "@wirework/store": "workspace:*",
    "@wirework/widget-contracts": "workspace:*",
    "antd": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.6.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
