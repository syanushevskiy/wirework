<mxfile host="app.diagrams.net" modified="2026-09-15T00:00:00.000Z" agent="wirework" version="24.0.0" type="device">
  <diagram id="wirework-overview" name="Overview (stakeholders)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="otitle" value="Wirework in one picture — users configure screens from a catalog of widgets; developers write widgets and business logic (actions) once; events connect them through shared state." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="1280" height="30" as="geometry"/></mxCell>
        <mxCell id="odev" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Developers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Build widgets and write business logic (actions) — in code, once." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="ousr" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Dashboard users&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Assemble and personalise screens in the builder — no code." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="60" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="ocat" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Widget catalog&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reusable building blocks: inputs, buttons, tables, labels… Each widget declares what data it needs and which events it raises. Every widget has a preview and automated checks." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="300" height="170" as="geometry"/></mxCell>
<mxCell id="oact" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Actions = business logic&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Named operations users can reuse on any screen: load data from the server, navigate, open a wizard, submit… Registered for the whole app or for one screen." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="300" height="170" as="geometry"/></mxCell>
<mxCell id="osvc" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Services &amp; APIs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Backend calls, routing, dialogs — used by actions only." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="ocfg" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Page configuration (data, not code)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Which widgets, where they sit, what data they read, and what happens on their events: update shared state, or run an action. Saved as data. Personal changes stay separate from the shared page." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="360" height="200" as="geometry"/></mxCell>
<mxCell id="oevt" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Events → reactions&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;A widget raises an event: clicked, changed, row selected. The configuration decides what follows — update shared state, or run an action (in order)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="440" width="360" height="150" as="geometry"/></mxCell>
<mxCell id="oscr" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Live screen&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;The configuration becomes a working page. The layout style is pluggable (grid, docking tabs…). Every problem is shown in place — one broken widget never breaks the page." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="200" width="460" height="200" as="geometry"/></mxCell>
<mxCell id="ost" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Shared state&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;One place for all data of a page: what widgets show and what they change. Widgets refresh the moment it changes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880" y="440" width="460" height="150" as="geometry"/></mxCell>
<mxCell id="ogua" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;What this gives you&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Users configure, developers code · everything is validated before it is shown · widgets, actions, layouts and personal overrides are all reusable across screens · a new design system or layout library plugs in without touching pages." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontSize=13;fillColor=#ffffff;strokeColor=#999999;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="440" y="640" width="900" height="90" as="geometry"/></mxCell>
        <mxCell id="oe1" value="build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="odev" target="ocat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="oe2" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="odev" target="oact"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="175"/><mxPoint x="380" y="175"/><mxPoint x="380" y="395"/><mxPoint x="300" y="395"/></Array></mxGeometry></mxCell>
<mxCell id="oe3" value="configure in the builder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ousr" target="ocfg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="170"/><mxPoint x="728" y="170"/></Array></mxGeometry></mxCell>
<mxCell id="oe4" value="use" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ousr" target="oscr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="oe5" value="pick from" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ocat" target="ocfg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="oe6" value="renders" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ocfg" target="oscr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="oe7" value="widget event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.02;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="oscr" target="oevt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="889" y="420"/><mxPoint x="840" y="420"/><mxPoint x="840" y="485"/></Array></mxGeometry></mxCell>
<mxCell id="oe8" value="update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="oevt" target="ost"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="oe9" value="run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="oevt" target="oact"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="oe10" value="call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="oact" target="osvc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="oe11" value="write results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="oact" target="ost"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="610"/><mxPoint x="1110" y="610"/></Array></mxGeometry></mxCell>
<mxCell id="oe12" value="refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;strokeWidth=2;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="ost" target="oscr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="wirework-architecture" name="Detailed (engineering)">
    <mxGraphModel dx="1600" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Wirework — widgets, events, reactions, actions, view layer. Business logic lives in host ACTIONS (and the services they call); widgets are presentation; view models are data." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="1560" height="30" as="geometry"/></mxCell>
        <mxCell id="bandA" value="CONFIGURATION — declarative data, no code (all three trees live in the Store)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;fillColor=#fff9e6;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1560" height="190" as="geometry"/></mxCell>
<mxCell id="bandB" value="HOST APPLICATION (React app / playground) — WHERE BUSINESS LOGIC LIVES" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;fillColor=#fbeaea;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1560" height="230" as="geometry"/></mxCell>
<mxCell id="bandC" value="VIEW LAYER — @wirework/react + layout-engine plugins (React only)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;fillColor=#eaf2fb;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1560" height="190" as="geometry"/></mxCell>
<mxCell id="bandD" value="CORE — framework-free (@wirework/schema · engine · store · events): pure functions over data" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;fillColor=#e9f5e6;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1560" height="210" as="geometry"/></mxCell>
<mxCell id="bandE" value="WIDGETS — @wirework/widget-contracts + implementations (presentation only)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontStyle=1;fontSize=13;fillColor=#f0e8f5;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1560" height="190" as="geometry"/></mxCell>
<mxCell id="A1" value="&lt;b&gt;View models&lt;/b&gt;&lt;br&gt;pages → templates (per engine) → cells {id, widget, model}&lt;br&gt;widget templates: inputs · settings · &lt;b&gt;on: reactions&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="A2" value="&lt;b&gt;User view models&lt;/b&gt; (overlay)&lt;br&gt;own page templates (&quot;my-own&quot;), selected view&lt;br&gt;per-CELL settings overrides" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="410" y="80" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="A3" value="&lt;b&gt;Data models&lt;/b&gt;&lt;br&gt;runs.data, demo.counter, ui.page, ui.dialog …&lt;br&gt;written only by reactions and actions" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="730" y="80" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="A4" value="Validated at boot and at resolve: every failure is a typed problem&lt;br&gt;Edited by the builder / page session / state inspector&lt;br&gt;Reactions are the ONLY logic here: set(path ← payload field | literal) or call(action, with)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1050" y="80" width="520" height="120" as="geometry"/></mxCell>
<mxCell id="B1" value="&lt;b&gt;Boot&lt;/b&gt; (once, before render)&lt;br&gt;createRegistry · createContracts · createLayoutEngines · &lt;b&gt;createActions&lt;/b&gt;&lt;br&gt;register widgets, contracts, engines, actions; validateViewModels" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="330" height="110" as="geometry"/></mxCell>
<mxCell id="B2" value="&lt;b&gt;ACTIONS = business logic&lt;/b&gt;&lt;br&gt;name &quot;ns/name&quot; · description · params (zod) · scope global | pages&lt;br&gt;async handler({ event, store, args, page })&lt;br&gt;e.g. runs/load: fetch → store.set(runs.data / runs.status)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="380" height="130" as="geometry"/></mxCell>
<mxCell id="B3" value="&lt;b&gt;Host services&lt;/b&gt;&lt;br&gt;API client · router · dialog manager&lt;br&gt;closed over by action handlers" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="810" y="300" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="B4" value="&lt;b&gt;Builder &amp; page session&lt;/b&gt;&lt;br&gt;add/edit/remove widgets, wire inputs, settings, reactions&lt;br&gt;layout ops (drag/resize) → replayed → Save writes the trees" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="300" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="B5" value="&lt;b&gt;Code listeners&lt;/b&gt; (optional)&lt;br&gt;useWidgetEvent(bus, eventFilter(def, name))&lt;br&gt;for behaviour nobody configures" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1390" y="300" width="190" height="130" as="geometry"/></mxCell>
<mxCell id="C1" value="&lt;b&gt;PageView&lt;/b&gt;&lt;br&gt;usePagePlan → plan · useReactions binds `on` while mounted&lt;br&gt;renderCell / renderChrome callbacks; page + user overlay in" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="C2" value="&lt;b&gt;Layout engine renderer&lt;/b&gt; (plugin)&lt;br&gt;react-grid-layout · gridstack · FlexLayout · flex-rows&lt;br&gt;places cells; edit mode: drag/resize → onChange(payload)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="560" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="C3" value="&lt;b&gt;CellView&lt;/b&gt;&lt;br&gt;widget component inside an error boundary&lt;br&gt;props: viewModel · &lt;b&gt;read-only store&lt;/b&gt; · cell-scoped &lt;b&gt;emit&lt;/b&gt; · chrome" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="C4" value="&lt;b&gt;Hooks&lt;/b&gt;&lt;br&gt;useStorePath (useSyncExternalStore) · useStoreSnapshot&lt;br&gt;useWidgetEvent · useReactions" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1110" y="560" width="460" height="120" as="geometry"/></mxCell>
<mxCell id="D1" value="&lt;b&gt;Registries&lt;/b&gt;&lt;br&gt;widgets · contracts · layout engines · actions&lt;br&gt;strict, loud, immutable after boot" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="D2" value="&lt;b&gt;resolvePage → Plan&lt;/b&gt;&lt;br&gt;template validated by its engine + cells by id&lt;br&gt;validateViewModels: typed problems" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="780" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="D3" value="&lt;b&gt;Emitter&lt;/b&gt; (per cell)&lt;br&gt;only declared events, validated payload&lt;br&gt;stamps {page, cell}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="780" width="220" height="130" as="geometry"/></mxCell>
<mxCell id="D4" value="&lt;b&gt;Reaction interpreter&lt;/b&gt;&lt;br&gt;on[event] → in order:&lt;br&gt;&lt;b&gt;set&lt;/b&gt;(path ← payload|literal) | &lt;b&gt;call&lt;/b&gt;(action, with)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="780" width="260" height="130" as="geometry"/></mxCell>
<mxCell id="D5" value="&lt;b&gt;Event bus&lt;/b&gt;&lt;br&gt;sync · filter {widget, name, page, cell}&lt;br&gt;listener isolation · loop guard" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1140" y="780" width="210" height="130" as="geometry"/></mxCell>
<mxCell id="D6" value="&lt;b&gt;Store&lt;/b&gt;&lt;br&gt;path tree, immutable updates&lt;br&gt;ancestor/descendant subscriptions" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1370" y="780" width="200" height="130" as="geometry"/></mxCell>
<mxCell id="E1" value="&lt;b&gt;Contract&lt;/b&gt; (kind)&lt;br&gt;inputs: ports + value type + default&lt;br&gt;events: payload, required, primary · settings (zod)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="1020" width="330" height="120" as="geometry"/></mxCell>
