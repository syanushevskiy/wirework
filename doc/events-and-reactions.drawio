        </mxCell>
        <mxCell id="p2-e-await-next" value="resolved — next" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p2-await" target="p2-next" edge="1">
          <mxGeometry relative="1" as="geometry">
