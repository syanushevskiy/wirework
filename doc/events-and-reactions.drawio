  </diagram>
  <diagram id="reaction-chain" name="2 · Reactions: how one event&#39;s chain runs">
    <mxGraphModel dx="2814" dy="729" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1019" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" value="Reactions — how one event&#39;s chain runs (packages/engine/src/reactions.ts)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="10" width="1580" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2-start" value="An event arrives for its (page, cell, name)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="160" y="60" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-next" value="Take the next reaction, in declaration order" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="160" y="160" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-any" value="Any left?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="235" y="260" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-done" value="Chain done" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="520" y="275" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-bound" value="Page still mounted?&lt;br&gt;(signal not aborted)" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="210" y="390" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-stopped" value="Stop — the page went away; the rest of the chain never starts" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="520" y="415" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-verb" value="Verb?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="235" y="540" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-set" value="&lt;b&gt;set&lt;/b&gt;&lt;br&gt;store.set(set, …) with &lt;i&gt;value&lt;/i&gt; if given, else the payload field at &lt;i&gt;from&lt;/i&gt;, else the whole payload.&lt;br&gt;A configuration path is refused." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="40" y="680" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-call" value="&lt;b&gt;call&lt;/b&gt;&lt;br&gt;actions.get(call).handler({ event, store, args: with ?? {}, signal })&lt;br&gt;An unknown action name throws." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="340" y="680" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-promise" value="Returned a Promise?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="395" y="830" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-await" value="Await it: the next reaction starts when it resolves" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="680" y="845" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-fail" value="&lt;b&gt;Failure&lt;/b&gt; — a set or call that throws, or an action that rejects: logged with widget, event and cell, and the chain STOPS. Never thrown at the widget that emitted." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="680" y="680" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-examples-title" value="Timing, by example (the demo page)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1060" y="60" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-example-filters" value="&lt;b&gt;Dependent filters&lt;/b&gt; — Applications&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;on.changed: [&lt;br&gt;&amp;nbsp;&amp;nbsp;{ set: &quot;filters.applications&quot;, from: &quot;value&quot; },&lt;br&gt;&amp;nbsp;&amp;nbsp;{ call: &quot;filters/sync-suites&quot; }&lt;br&gt;]&lt;/font&gt;&lt;br&gt;Both are synchronous, so both writes land inside the same pick: Test suites re-renders with the new options, stale suites already dropped." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1060" y="100" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2-example-paging" value="&lt;b&gt;Server paging&lt;/b&gt; — the paginator&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;on.changed: [&lt;br&gt;&amp;nbsp;&amp;nbsp;{ set: &quot;runs.page&quot;, from: &quot;page&quot; },&lt;br&gt;&amp;nbsp;&amp;nbsp;{ set: &quot;runs.pageSize&quot;, from: &quot;pageSize&quot; },&lt;br&gt;&amp;nbsp;&amp;nbsp;{ call: &quot;runs/load-page&quot; }&lt;br&gt;]&lt;/font&gt;&lt;br&gt;The two sets land at once (the pager moves); the action is async and awaited (about 600 ms) — a reaction after it would wait. Leaving the page during the load aborts its signal." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1060" y="290" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2-example-input" value="&lt;b&gt;Controlled input&lt;/b&gt; — Your name&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;on.changed: [ { set: &quot;demo.name&quot;, from: &quot;value&quot; } ]&lt;/font&gt;&lt;br&gt;The write happens inside the keystroke&#39;s own handler, so the input shows the stored text immediately and the caret stays where the user typed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="1060" y="510" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-logic" value="&lt;b&gt;Where logic goes&lt;/b&gt;&lt;br&gt;Reactions never transform: &lt;i&gt;from&lt;/i&gt; selects a payload field, &lt;i&gt;value&lt;/i&gt; is a literal, &lt;i&gt;with&lt;/i&gt; is static. Anything that needs a computation — options that depend on another choice, a server request — is an ACTION with a name, written once in code." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" parent="1" vertex="1">
          <mxGeometry x="1060" y="650" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-start" target="p2-next" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-any" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-next" target="p2-any" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-done" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p2-any" target="p2-done" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-bound" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-any" target="p2-bound" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-stopped" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p2-bound" target="p2-stopped" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-verb" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-bound" target="p2-verb" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e-set" value="set" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-verb" target="p2-set" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="170" y="585" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-call" value="call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="p2-verb" target="p2-call" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="585" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2-e-set-next" value="next, at once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="p2-set" target="p2-next" edge="1">
          <mxGeometry relative="1" as="geometry">
