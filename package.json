{
  "name": "wirework",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "lint:publish": "pnpm -r --filter \"./packages/**\" --filter \"!@wirework/view-data-models-examples\" exec publint",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node scripts/check-test-scripts.mjs && pnpm --no-bail --filter \"./packages/**\" run test",
    "test:e2e": "pnpm --filter e2e test",
    "e2e": "pnpm --filter e2e test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test:unit && pnpm test:e2e",
    "dev": "pnpm --filter playground dev",
    "storybook": "pnpm --filter @wirework/antd-widgets storybook",
    "build-storybook": "pnpm --filter @wirework/antd-widgets build-storybook"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "playwright-core@1.55.0": "patches/playwright-core@1.55.0.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "typescript-eslint": "^8.70.1"
  }
}
