{
  "widgets.archive.error": {
    "default": {
      "inputs": {
        "text": "archive.error"
      },
      "text": "",
      "tone": "danger"
    }
  },
  "widgets.archive.position": {
    "default": {
      "inputs": {
        "position": "archive.position",
        "visible": "archive.visible",
        "total": "archive.total",
        "hasMore": "archive.hasMore"
      },
      "label": "Position in the archive"
    }
  },
  "widgets.archive.table": {
    "default": {
      "inputs": {
        "rows": "archive.data",
        "loading": "archive.loading",
        "columns": "archive.columns",
        "total": "archive.total",
        "hasMore": "archive.hasMore",
        "offset": "archive.offset",
        "position": "archive.position",
        "filterIn": "archive.filterIn",
        "filterLike": "archive.filterLike",
        "filterBetween": "archive.filterBetween",
        "orderBy": "archive.orderBy"
      },
      "on": {
        "load": [
          {
            "call": "table-view/load",
            "with": {
              "url": "/api/v1/view/archive",
              "into": "archive",
              "metadata": true,
              "pageSize": 200,
              "countRows": false,
              "columns": {
                "id": {
                  "required": true
                },
                "started": {
                  "hidden": false
                },
                "state": {
                  "cell": {
                    "kind": "tag",
                    "tones": {
                      "Success": "success",
                      "Failed": "danger",
                      "Running": "info",
                      "Queued": "default"
                    }
                  }
                }
              }
            }
          }
        ],
        "row-action": [
          {
            "call": "archive/set-favorite"
          }
        ],
        "window": [
          {
            "set": "archive.wanted"
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "archive",
              "window": true
            }
          }
        ],
        "position-changed": [
          {
            "set": "archive.position",
            "from": "position"
          },
          {
            "set": "archive.visible",
            "from": "visible"
          }
        ],
        "filter-changed": [
          {
            "set": "archive.filterIn",
            "from": "filterIn"
          },
          {
            "set": "archive.filterLike",
            "from": "filterLike"
          },
          {
            "set": "archive.filterBetween",
            "from": "filterBetween"
          },
          {
            "set": "archive.wanted",
            "value": 0
          },
          {
            "set": "archive.position",
            "value": 0
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "archive",
              "window": true
            }
          }
        ],
        "sort-changed": [
          {
            "set": "archive.orderBy",
            "from": "orderBy"
          },
          {
            "set": "archive.wanted",
            "value": 0
          },
          {
            "set": "archive.position",
            "value": 0
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "archive",
              "window": true
            }
          }
        ]
      },
      "height": 320,
      "windowed": true,
      "rowActions": [
        {
          "name": "favorite"
        }
      ],
      "columnMenu": true
    }
  },
  "widgets.archive.title": {
    "default": {
      "text": "Archive — a long list nobody counts: two hundred runs at a time, how many there are known only at its end",
      "tone": "accent"
    }
  }
}
