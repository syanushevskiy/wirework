{
  "templates": {
    "default": {
      "engine": "flex-rows",
      "rows": [
        {
          "cells": [
            {
              "id": "label-archive",
              "widget": "antd-label",
              "model": "widgets.archive.title",
              "template": "default",
              "classes": "w-full"
            }
          ]
        },
        {
          "cells": [
            {
              "id": "table-archive",
              "widget": "antd-infinite-table",
              "model": "widgets.archive.table",
              "template": "default",
              "classes": "w-full"
            }
          ]
        },
        {
          "cells": [
            {
              "id": "position-archive",
              "widget": "antd-list-position",
              "model": "widgets.archive.position",
              "template": "default",
              "classes": "w-full"
            }
          ]
        },
        {
          "cells": [
            {
              "id": "label-archive-error",
              "widget": "antd-label",
              "model": "widgets.archive.error",
              "template": "default",
              "classes": "w-full"
            }
          ]
        }
      ]
    }
  }
}
