{
  "templates": {
    "default": {
      "engine": "react-grid-layout",
      "cells": [
        {
          "id": "label-archive",
          "widget": "antd-label",
          "model": "widgets.archive.title",
          "template": "default",
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 1
        },
        {
          "id": "table-archive",
          "widget": "antd-infinite-table",
          "model": "widgets.archive.table",
          "template": "default",
          "x": 0,
          "y": 1,
          "w": 12,
          "h": 10
        },
        {
          "id": "position-archive",
          "widget": "antd-list-position",
          "model": "widgets.archive.position",
          "template": "default",
          "x": 0,
          "y": 11,
          "w": 12,
          "h": 1
        },
        {
          "id": "label-archive-error",
          "widget": "antd-label",
          "model": "widgets.archive.error",
          "template": "default",
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 1
        }
      ]
    }
  }
}
