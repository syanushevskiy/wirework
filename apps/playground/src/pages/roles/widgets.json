{
  "widgets.roles.adminMode": {
    "default": {
      "inputs": {
        "checked": "app.settings.adminMode"
      },
      "label": "Admin mode",
      "when": [
        {
          "path": "app.user.roles",
          "is": "user/has-role",
          "to": "admin"
        }
      ]
    }
  },
  "widgets.roles.clearNote": {
    "default": {
      "label": "Clear the note — admin mode",
      "variant": "danger",
      "on": {
        "clicked": [
          {
            "set": "app.settings.note",
            "value": ""
          }
        ]
      },
      "when": [
        {
          "path": "app.settings.adminMode",
          "is": "true"
        },
        {
          "path": "app.user.roles",
          "is": "user/has-role",
          "to": "admin"
        }
      ],
      "appear": "fade",
      "disappear": "fade"
    }
  },
  "widgets.roles.approval": {
    "default": {
      "inputs": {
        "value": "roles.approval"
      },
      "label": "Approval — admin only"
    }
  },
  "widgets.roles.approve": {
    "default": {
      "label": "Approve — admin only",
      "on": {
        "clicked": [
          {
            "set": "roles.approval",
            "value": "approved by the admin"
          }
        ]
      }
    }
  },
  "widgets.roles.how": {
    "default": {
      "text": "Everyone sees the note. The admin sees this card in its \"admin\" template — roles.json picks it for the admin — which holds a button and its echo as well. Sign in as admin above to see them.",
      "tone": "muted"
    }
  },
  "widgets.roles.note": {
    "default": {
      "inputs": {
        "value": "app.settings.note"
      },
      "label": "Your note — everyone",
      "placeholder": "type anything"
    }
  }
}
