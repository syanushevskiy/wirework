{
  "widgets.pagination.applicationsFilter": {
    "default": {
      "inputs": {
        "value": "filters.applications",
        "options": "app.lists.applications"
      },
      "on": {
        "changed": [
          {
            "call": "filters/sync-suites"
          }
        ]
      },
      "label": "Applications",
      "placeholder": "choose applications"
    }
  },
  "widgets.pagination.deleteRun": {
    "default": {
      "label": "Delete run",
      "variant": "danger",
      "confirm": "Delete this run?",
      "on": {
        "clicked": [
          {
            "call": "runs/delete-selected"
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "pagination"
            }
          }
        ]
      },
      "when": [
        {
          "path": "pagination.selected",
          "is": "empty",
          "not": true
        },
        {
          "path": "app.user.roles",
          "is": "user/has-role",
          "to": "wirework-admin"
        }
      ]
    }
  },
  "widgets.pagination.echoSelectedRun": {
    "default": {
      "inputs": {
        "value": "pagination.selected"
      },
      "label": "Selected run"
    }
  },
  "widgets.pagination.error": {
    "default": {
      "inputs": {
        "text": "pagination.error"
      },
      "text": "",
      "tone": "danger"
    }
  },
  "widgets.pagination.filterBar": {
    "default": {
      "inputs": {
        "filters": "pagination.filters",
        "value": "pagination.filterIn"
      },
      "on": {
        "changed": [
          {
            "set": "pagination.page",
            "value": 1
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "pagination"
            }
          }
        ]
      },
      "placeholder": "any"
    }
  },
  "widgets.pagination.openRun": {
    "default": {
      "label": "Open run",
      "on": {
        "clicked": [
          {
            "call": "runs/open-selected"
          }
        ]
      },
      "when": [
        {
          "path": "pagination.selected",
          "is": "empty",
          "not": true
        }
      ],
      "appear": "fade",
      "disappear": "fade"
    }
  },
  "widgets.pagination.pagination": {
    "default": {
      "inputs": {
        "page": "pagination.page",
        "total": "pagination.total",
        "pageSize": "pagination.pageSize"
      },
      "on": {
        "changed": [
          {
            "set": "pagination.pageSize",
            "from": "pageSize"
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "pagination"
            }
          }
        ]
      }
    }
  },
  "widgets.pagination.refresher": {
    "default": {
      "inputs": {
        "schedule": "pagination.autoRefresh",
        "busy": "pagination.loading"
      },
      "on": {
        "refresh": [
          {
            "call": "table-view/load",
            "with": {
              "into": "pagination"
            }
          }
        ]
      }
    }
  },
  "widgets.pagination.startedRange": {
    "default": {
      "inputs": {
        "value": "pagination.filterBetween.started"
      },
      "label": "Started between",
      "on": {
        "changed": [
          {
            "set": "pagination.page",
            "value": 1
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "pagination"
            }
          }
        ]
      }
    }
  },
  "widgets.pagination.suitesFilter": {
    "default": {
      "inputs": {
        "value": "filters.suites",
        "options": "filters.suiteOptions"
      },
      "label": "Test suites",
      "placeholder": "choose applications first"
    }
  },
  "widgets.pagination.table": {
    "default": {
      "inputs": {
        "rows": "pagination.data",
        "loading": "pagination.loading",
        "columns": "pagination.columns",
        "filterIn": "pagination.filterIn",
        "filterLike": "pagination.filterLike",
        "orderBy": "pagination.orderBy"
      },
      "headerFilters": true,
      "toolbar": [
        {
          "name": "reset-filters"
        }
      ],
      "on": {
        "load": [
          {
            "call": "table-view/load",
            "with": {
              "url": "/api/v1/view/runs",
              "into": "pagination",
              "metadata": true,
              "pageSize": 5,
              "columns": {
                "inbound": {
                  "hidden": true
                },
                "id": {
                  "cell": {
                    "kind": "link",
                    "to": "/demo/runs/{id}"
                  }
                },
                "name": {
                  "cell": {
                    "kind": "link",
                    "to": "/demo/runs/{id}"
                  }
                },
                "reference": {
                  "cell": {
                    "kind": "custom",
                    "name": "copy"
                  }
                },
                "state": {
                  "cell": {
                    "kind": "tag",
                    "tones": {
                      "Success": "success",
                      "Failed": "danger",
                      "Running": "info",
                      "Queued": "default"
                    }
                  }
                }
              },
              "filters": {
                "inbound": false,
                "name": {
                  "label": "Suite",
                  "values": ["Nightly regression", "Smoke suite", "Migration check"]
                }
              }
            }
          }
        ],
        "filter-changed": [
          {
            "set": "pagination.filterIn",
            "from": "filterIn"
          },
          {
            "set": "pagination.filterLike",
            "from": "filterLike"
          },
          {
            "set": "pagination.page",
            "value": 1
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "pagination"
            }
          }
        ],
        "sort-changed": [
          {
            "set": "pagination.orderBy",
            "from": "orderBy"
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "pagination"
            }
          }
        ],
        "link-clicked": [
          {
            "call": "nav/follow"
          }
        ]
      }
    },
    "admin": {
      "inputs": {
        "rows": "pagination.data",
        "loading": "pagination.loading",
        "columns": "pagination.columns",
        "filterIn": "pagination.filterIn",
        "filterLike": "pagination.filterLike",
        "orderBy": "pagination.orderBy"
      },
      "headerFilters": true,
      "toolbar": [
        {
          "name": "reset-filters"
        }
      ],
      "on": {
        "load": [
          {
            "call": "table-view/load",
            "with": {
              "url": "/api/v1/view/runs/all",
              "into": "pagination",
              "metadata": true,
              "pageSize": 5,
              "columns": {
                "inbound": {
                  "hidden": true
                },
                "id": {
                  "cell": {
                    "kind": "link",
                    "to": "/demo/runs/{id}"
                  }
                },
                "name": {
                  "cell": {
                    "kind": "link",
                    "to": "/demo/runs/{id}"
                  }
                },
                "reference": {
                  "cell": {
                    "kind": "custom",
                    "name": "copy"
                  }
                },
                "state": {
                  "cell": {
                    "kind": "tag",
                    "tones": {
                      "Success": "success",
                      "Failed": "danger",
                      "Running": "info",
                      "Queued": "default"
                    }
                  }
                }
              },
              "filters": {
                "inbound": false,
                "name": {
                  "label": "Suite",
                  "values": ["Nightly regression", "Smoke suite", "Migration check"]
                }
              }
            }
          }
        ],
        "filter-changed": [
          {
            "set": "pagination.filterIn",
            "from": "filterIn"
          },
          {
            "set": "pagination.filterLike",
            "from": "filterLike"
          },
          {
            "set": "pagination.page",
            "value": 1
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "pagination"
            }
          }
        ],
        "sort-changed": [
          {
            "set": "pagination.orderBy",
            "from": "orderBy"
          },
          {
            "call": "table-view/load",
            "with": {
              "into": "pagination"
            }
          }
        ],
        "link-clicked": [
          {
            "call": "nav/follow"
          }
        ]
      }
    }
  }
}
