{
  "templates": {
    "default": {
      "engine": "flex-rows",
      "rows": [
        {
          "cells": [
            {
              "id": "label-archive",
              "widget": "antd-label",
              "model": "widgets.infinite-list.title",
              "template": "default",
              "classes": "w-full"
            }
          ]
        },
        {
          "cells": [
            {
              "id": "table-archive",
              "widget": "antd-infinite-table",
              "model": "widgets.infinite-list.table",
              "template": "default",
              "classes": "w-full"
            }
          ]
        },
        {
          "classes": "items-center gap-4",
          "cells": [
            {
              "id": "position-archive",
              "widget": "antd-list-position",
              "model": "widgets.infinite-list.position",
              "template": "default",
              "classes": "flex-1"
            },
            {
              "id": "pages-archive",
              "widget": "antd-list-position",
              "model": "widgets.infinite-list.pages",
              "template": "default",
              "classes": "flex-none"
            }
          ]
        },
        {
          "cells": [
            {
              "id": "label-archive-error",
              "widget": "antd-label",
              "model": "widgets.infinite-list.error",
              "template": "default",
              "classes": "w-full"
            }
          ]
        }
      ]
    }
  }
}
