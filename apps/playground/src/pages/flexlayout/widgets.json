{
  "widgets.flexlayout.autoRefresh": {
    "default": {
      "inputs": {
        "checked": "app.settings.autoRefresh"
      },
      "label": "Auto-refresh"
    }
  },
  "widgets.flexlayout.clicker": {
    "default": {
      "inputs": {
        "value": "demo.counter"
      },
      "step": 1,
      "label": "Click"
    }
  },
  "widgets.flexlayout.clicks": {
    "default": {
      "inputs": {
        "value": "demo.counter"
      },
      "title": "Clicks"
    }
  },
  "widgets.flexlayout.greeting": {
    "default": {
      "inputs": {
        "text": "app.settings.displayName"
      },
      "text": "Type a name to be greeted",
      "tone": "muted"
    }
  },
  "widgets.flexlayout.name": {
    "default": {
      "inputs": {
        "value": "app.settings.displayName"
      },
      "label": "Your name",
      "placeholder": "type a name"
    }
  },
  "widgets.flexlayout.nameAlice": {
    "default": {
      "label": "Alice",
      "on": {
        "clicked": [
          {
            "set": "app.settings.displayName",
            "value": "Alice"
          }
        ]
      }
    }
  },
  "widgets.flexlayout.nameBob": {
    "default": {
      "label": "Bob",
      "variant": "secondary",
      "on": {
        "clicked": [
          {
            "set": "app.settings.displayName",
            "value": "Bob"
          }
        ]
      }
    }
  },
  "widgets.flexlayout.nameClear": {
    "default": {
      "label": "Clear",
      "variant": "dashed",
      "on": {
        "clicked": [
          {
            "set": "app.settings.displayName",
            "value": ""
          }
        ]
      }
    }
  },
  "widgets.flexlayout.reset": {
    "default": {
      "label": "Reset",
      "variant": "secondary",
      "on": {
        "clicked": [
          {
            "call": "reset-counter"
          }
        ]
      }
    }
  },
  "widgets.flexlayout.sessionName": {
    "default": {
      "inputs": {
        "text": "app.user.name"
      },
      "text": "Signing in…",
      "tone": "accent"
    }
  },
  "widgets.flexlayout.sessionRoles": {
    "default": {
      "inputs": {
        "value": "app.user.roles"
      },
      "label": "Roles (from the session)"
    }
  },
  "widgets.flexlayout.sessionTitle": {
    "default": {
      "inputs": {
        "text": "app.user.title"
      },
      "text": "title",
      "tone": "info"
    }
  }
}
